{
  "name": "grammarlens-proxy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Operation-based Cloudflare Workers proxy in front of the Anthropic API for GrammarLens — see docs/build-log.md for why this exists.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/check-placeholders.mjs && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p eval",
    "eval": "esbuild eval/run.ts --bundle --platform=node --format=esm --log-level=warning --outfile=eval/.build/run.mjs && node eval/.build/run.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260905.1",
    "@types/node": "^24.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20260903.1": true
  }
}
